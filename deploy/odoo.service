[Unit]
Description=Odoo 16
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=odoo
Group=odoo
WorkingDirectory=/opt/odoo/odoo
Environment=HOME=/opt/odoo
ExecStart=/opt/odoo/venv/bin/python /opt/odoo/odoo/odoo-bin --config=/opt/odoo/.odoorc --http-interface=0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
